{
    "dependencies": [
        "oniguruma",
        "zlib",
        "libpng",
        "libwebp",
        "libjpeg-turbo",
        "libvorbis",
        "opusfile",
        "freetype",
        "plutovg",

        {
            "name": "sdl3",
            "features": ["vulkan"],
            "platform": "!ios & !osx"
        },
        {
            "name": "sdl3",
            "platform": "ios | osx"
        },
        "sdl3-ttf",
        "glm",
        {
            "name": "glad",
            "features": ["loader"],
            "platform": "windows | linux | osx"
        },
        {
            "name": "glad",
            "features": ["egl", "loader"],
            "platform": "android | emscripten | ios"
        },
        {
            "name": "vulkan",
            "platform": "windows | android"
        },
        {
            "name": "vulkan-headers",
            "platform": "linux"
        }
    ],
    "default-features": ["ffmpeg"],
    "features": {
        "ffmpeg": {
            "description": "FFmpeg for movies and the wuffmpeg sound decoder. A host that brings its own FFmpeg (KRKR_FFMPEG_FRAMEWORK) turns default features off.",
            "dependencies": [
                {
                    "name": "ffmpeg",
                    "platform": "!emscripten"
                }
            ]
        }
    },
    "builtin-baseline": "8e8dfb4ba483886936ded5ca201b500b8d8b0096",
    "overrides": []
}
